# Only EXPO_PUBLIC_ values are bundled into the app. Never put secrets here.
EXPO_PUBLIC_SNTO_ENV=local
EXPO_PUBLIC_SNTO_API_BASE_URL=http://127.0.0.1:8000

# Fase 2 (ADR-014). Leave unset (or "false") to keep the synthetic fixture
# repository — the safe default. Setting EXPO_PUBLIC_SNTO_API_BASE_URL alone
# does NOT switch to real data; this flag is the only thing that does.
EXPO_PUBLIC_SNTO_USE_REMOTE_API=false
# Which persisted territory (by slug) the app reads when the flag above is true.
EXPO_PUBLIC_SNTO_TERRITORY_SLUG=pnsg
