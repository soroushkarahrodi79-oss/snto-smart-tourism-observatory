# ============================================================
# SMART TOURISM OBSERVATORY — .gitignore
# ============================================================

# --- Datos geoespaciales pesados (NUNCA subir a GitHub) -----
data/

# --- Formatos raster y archivos satelitales (por si escapan) -
*.tif
*.tiff
*.img
*.vrt
*.nc
*.zip
*.tar.gz
*.gz

# --- Directorios de imágenes Sentinel-2 (formato ESA SAFE) --
*.SAFE/

# --- Python: caché y compilados -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Entornos virtuales -------------------------------------
.venv/
.venv-*/
.venv*/
venv/
env/
ENV/

# --- pytest y cobertura -------------------------------------
.pytest_cache/
.coverage
htmlcov/
*.xml

# --- Paquetes Python instalables ----------------------------
*.egg-info/
dist/
build/
*.egg

# --- Variables de entorno (secretos) ------------------------
.env
!.env.example

# --- Bases de datos locales ---------------------------------
*.db
*.sqlite3

# --- Claude Code (metadatos locales, no subir) --------------
.claude/

# --- IDEs y Sistemas Operativos -----------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*~

# --- Archivos de salida sueltos -----------------------------
CUsers*.txt
*.out.txt

# --- Export GIS generado (reproducible vía scripts/export_gis.py) ---
clean_assets/gis_export/

# --- Validación de campo: outputs generados (la plantilla sí se versiona) ---
clean_assets/field_validation/*
!clean_assets/field_validation/*_template.csv
# Reference administrative boundary (input to scripts/paper1/generate_plot_plan.py)
# is versioned; the generated *_plot_plan* outputs are NOT (regenerable, and the
# jurisdiction is provisional until the IGN boundary lands).
!clean_assets/field_validation/reference/

# --- ArcGIS DEMO: registros locales y metadatos de cuenta -----------------
arcgis/demo/pnsg/item-registry.local.yaml
docs/integrations/arcgis/experience-builder/item-registry.local.yaml

# --- ArcGIS DEMO: outputs reproducibles y exportaciones privadas ----------
outputs/arcgis-field-validation-demo/
arcgis/demo/pnsg/field-submissions/
arcgis/demo/pnsg/survey123-exports/
arcgis/demo/pnsg/private-exports/
arcgis/demo/pnsg/raw-field-exports/

# --- ArcGIS DEMO: adjuntos, fotos, paquetes offline y cachés --------------
arcgis/demo/pnsg/attachments/
arcgis/demo/pnsg/photos/
arcgis/demo/pnsg/offline/
arcgis/demo/pnsg/.arcgis-cache/
arcgis/demo/pnsg/*.mmpk
arcgis/demo/pnsg/*.tpkx
arcgis/demo/pnsg/*.vtpk

# --- Office: bloqueos temporales; el XLSForm canónico sí se versiona ------
~$*.xlsx
